# =============================================================================
# roxi-agent environment
# =============================================================================
# Copy this file to .env.local and fill in the values:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored: never commit real keys or tokens.
# Everything runs through `make` (see Makefile), which passes .env.local to
# Docker Compose and the containers. The agent checks its variables at startup
# and lists every missing or invalid one together.
# =============================================================================


# -----------------------------------------------------------------------------
# AI models (required)
# -----------------------------------------------------------------------------
# Each model use has its own provider, model and API key, so usage and limits
# stay separate. The same key may be used for both.
#
# Providers and models:
#   deepseek - deepseek-v4-flash (fast, cheap), deepseek-v4-pro (stronger)
#              Key: https://platform.deepseek.com/api_keys
#   openai   - gpt-6-luna (routine tasks), gpt-6-sol (hard reasoning)
#              Key: https://platform.openai.com/api-keys

# Main model: talks with the group and runs tools.
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-flash
AGENT_MODEL_API_KEY=your-api-key

# Model that summarizes notes; a cheap, fast model is enough.
NOTE_SUMMARY_MODEL_PROVIDER=deepseek
NOTE_SUMMARY_MODEL=deepseek-v4-flash
NOTE_SUMMARY_MODEL_API_KEY=your-api-key


# -----------------------------------------------------------------------------
# Notes (optional)
# -----------------------------------------------------------------------------
# The most notes a group can keep (default: 100). At the limit, members must
# delete an old note before saving a new one.
#MAX_NOTES_PER_GROUP=100


# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
# Create a bot with @BotFather in Telegram (/newbot); it gives you the token.
# To let the bot see every group message, not only commands and mentions,
# turn off its privacy mode: @BotFather -> /setprivacy -> Disable.

# Bot username without the leading @ (optional; used to detect mentions).
TELEGRAM_BOT_USERNAME=YourBotName_bot
# Bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Any random string; the local relay sends it with each update and the agent
# rejects updates without it. Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-a-random-string


# -----------------------------------------------------------------------------
# Database (local Postgres from docker-compose.yml)
# -----------------------------------------------------------------------------
# Docker Compose creates the database with these credentials on its first start.
# Changing the user, password or name later needs a fresh database:
#   make down && docker volume rm roxi-agent-postgres-data && make db-setup
DB_USER=roxi
DB_PASSWORD=change-me
DB_NAME=roxi_agent
# Host port for Postgres; 5434 avoids clashing with another local Postgres.
DB_PORT=5434

# Connection string for the app tables and eve's sessions. Built from the values
# above; leave it as is unless you use another Postgres.
# Inside Docker the agent container overrides it to reach the "postgres" service.
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@127.0.0.1:${DB_PORT}/${DB_NAME}

# Postgres schema for the app tables (optional, default: roxi_agent).
# Changing it starts a fresh, empty schema.
#APP_SCHEMA=roxi_agent


# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# true: human-readable logs (handy locally); false: JSON lines (default).
LOG_PRETTY=true
# trace | debug | info | warn | error | fatal | silent (default: info)
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Server (optional)
# -----------------------------------------------------------------------------
# Host port for the agent (make run / make up); default: 2000.
EVE_PORT=2000
